# Copy this file to .env at the repository root for Docker/ngrok demos.
EARTHLENS_ENV=development
NASA_DATA_MODE=demo
EARTHLENS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000

# Required only for the optional ngrok profile.
# Get a token at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
