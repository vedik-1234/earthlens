# EarthLens Backend Configuration

# Environment
EARTHLENS_ENV=development
EARTHLENS_DEBUG=false

# Security
EARTHLENS_JWT_SECRET=your-secure-random-secret-key-change-in-production
EARTHLENS_JWT_TTL_HOURS=24
EARTHLENS_REFRESH_TTL_DAYS=7

# Database
EARTHLENS_DB_PATH=/tmp/earthlens.db

# CORS & Trusted Hosts
EARTHLENS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
EARTHLENS_TRUSTED_HOSTS=localhost,127.0.0.1

# NASA Data Mode (demo or production)
NASA_DATA_MODE=demo
CACHE_DIR=/tmp/earthlens-cache

# API Rate Limiting (requests per minute)
EARTHLENS_RATE_LIMIT=60

# Logging
EARTHLENS_LOG_LEVEL=INFO
